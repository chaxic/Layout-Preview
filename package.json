{
  "name": "layout-preview",
  "version": "1.0.0",
  "description": "Drop-in dev toolbar for previewing responsive layouts at device sizes, with container-query (inline) and media-query (iframe) modes.",
  "keywords": [
    "responsive",
    "layout",
    "breakpoints",
    "viewport",
    "devtools",
    "container-queries",
    "media-queries"
  ],
  "license": "MIT",
  "author": "chaxic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chaxic/layout-preview.git"
  },
  "homepage": "https://github.com/chaxic/layout-preview#readme",
  "bugs": {
    "url": "https://github.com/chaxic/layout-preview/issues"
  },
  "type": "module",
  "main": "./dist/layout-preview.mjs",
  "module": "./dist/layout-preview.mjs",
  "browser": "./dist/layout-preview.js",
  "unpkg": "./dist/layout-preview.js",
  "jsdelivr": "./dist/layout-preview.js",
  "exports": {
    ".": {
      "import": "./dist/layout-preview.mjs",
      "default": "./dist/layout-preview.js"
    },
    "./auto": "./dist/auto.mjs",
    "./iife": "./dist/layout-preview.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "./dist/auto.mjs",
    "./dist/layout-preview.js"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/utils.test.js",
    "check": "npm test && npm run build",
    "dev": "npm run build && npx --yes serve . -l 5173"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": ">=18"
  }
}
